\deqn{p^{a - 1} (1 - p)^{b + \alpha - 1} [E + \beta (k + 1) (1 - p)]^{-(\alpha + Y)}}{p^(a - 1) * (1 - p)^(b + alpha - 1) * (E + beta * (k + 1) * (1 - p))^(-(alpha + Y))}
